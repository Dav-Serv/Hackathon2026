{
  "info": {
    "name": "Laravel Auth API",
    "description": "Testing manual auth, Sanctum Bearer Token, dan Google OAuth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "mahasiswa@amikom.ac.id" },
    { "key": "password", "value": "Password123!" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mahasiswa Amikom\",\n  \"nim_nip\": \"2300012345\",\n  \"no_hp\": \"081234567890\",\n  \"alamat\": \"Yogyakarta\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register berhasil', function () { pm.expect(pm.response.code).to.be.oneOf([201, 422]); });",
                  "if (pm.response.code === 201) { const json = pm.response.json(); if (json.access_token) pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login berhasil', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google OAuth Redirect",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Buka URL ini di browser, bukan Send dari Postman.",
            "url": "{{base_url}}/api/auth/google/redirect"
          }
        },
        {
          "name": "Google OAuth Callback",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "description": "Jangan dipanggil langsung tanpa parameter code. URL ini dipanggil Google setelah login.",
            "url": "{{base_url}}/api/auth/google/callback?code={{google_code}}"
          }
        }
      ]
    },
    {
      "name": "Protected",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/logout"
          }
        }
      ]
    }
  ]
}
