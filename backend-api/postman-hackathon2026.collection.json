  },
  "variable": [
    {"key":"base_url","value":"http://127.0.0.1:8000"},
    {"key":"token_mahasiswa","value":""},{"key":"token_dpl","value":""},{"key":"token_admin","value":""},{"key":"token_kaprodi","value":""},
    {"key":"approval_token","value":""},{"key":"dokumen_id","value":""},{"key":"magang_id","value":""},{"key":"magang_status","value":""},{"key":"usulan_status","value":""},{"key":"usulan_detail_id","value":""},{"key":"surat_pengantar_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/surat.pdf"},{"key":"logbook_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/logbook.pdf"},{"key":"laporan_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/laporan.pdf"},{"key":"sertifikat_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/sertifikat.pdf"},{"key":"klaim_detail_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/activiteit.pdf"},{"key":"mitra_industri_id","value":"1"},{"key":"supervisor_mitra_id","value":"1"},{"key":"dpl_id","value":"2"},{"key":"proposal_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/proposal.pdf"},{"key":"bukti_diterima_file","value":"/home/davserv/Hackathon2026/backend-api/tests/Fixtures/bukti_diterima.pdf"},{"key":"surat_pengantar_id","value":""},{"key":"usulan_id","value":""},{"key":"klaim_id","value":""},{"key":"mata_kuliah_id","value":""},{"key":"cpmk_id","value":""}
  ],
  "event": [{"listen":"test","script":{"type":"text/javascript","exec":["if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.headers.get('Content-Type')?.includes('json')) { const d=pm.response.json(); const x=d.data || d; const path=pm.request.url.toString(); const map=path.includes('/surat-pengantar') ? 'surat_pengantar_id' : path.includes('/usulan-konversi') && pm.request.method === 'POST' ? 'usulan_id' : path.includes('/klaim-konversi') && pm.request.method === 'POST' ? 'klaim_id' : path.includes('/mata-kuliah/') && path.includes('/cpmk') ? 'cpmk_id' : path.endsWith('/mata-kuliah') ? 'mata_kuliah_id' : path.includes('/dokumen/') ? 'dokumen_id' : null; if (map && x && x.id != null) pm.environment.set(map, String(x.id)); }"]}}],
  "item": [
    {"name":"00 Auth setup","item":[
      {"name":"Login mahasiswa","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"mahasiswa@students.amikom.ac.id\",\n  \"password\": \"Password123!\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));","if (pm.response.code >= 200 && pm.response.code < 300) { const d = pm.response.json(); const token = d.access_token || (d.data && d.data.access_token); if (token) pm.environment.set('token_mahasiswa', token); }"]}}]},
      {"name":"Login DPL","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"dpl@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));","if (pm.response.code >= 200 && pm.response.code < 300) { const d = pm.response.json(); const token = d.access_token || (d.data && d.data.access_token); if (token) pm.environment.set('token_dpl', token); }"]}}]},
      {"name":"Login admin","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin.prodi@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));","if (pm.response.code >= 200 && pm.response.code < 300) { const d = pm.response.json(); const token = d.access_token || (d.data && d.data.access_token); if (token) pm.environment.set('token_admin', token); }"]}}]},
      {"name":"Login kaprodi","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"kaprodi@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));","if (pm.response.code >= 200 && pm.response.code < 300) { const d = pm.response.json(); const token = d.access_token || (d.data && d.data.access_token); if (token) pm.environment.set('token_kaprodi', token); }"]}}]},
      {"name":"Google callback (manual only)","request":{"method":"GET","url":"{{base_url}}/api/auth/google/callback","description":"Manual only. Disabled for automated runs.","disabled":true}}
    ]},
    {"name":"Mahasiswa workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_mahasiswa}}","type":"string"}]},"item":[
      {"name":"Me","request":{"method":"GET","url":"{{base_url}}/api/me"}},{"name":"Dashboard","request":{"method":"GET","url":"{{base_url}}/api/mahasiswa/dashboard"}},{"name":"List magang","request":{"method":"GET","url":"{{base_url}}/api/magang"}},
      {"name":"Create magang","request":{"method":"POST","body":{"mode":"formdata","formdata":[{"key":"industry_name","value":"PT Hackathon Industri","type":"text"},{"key":"industry_address","value":"Jl. Industri No. 1","type":"text"},{"key":"industry_field","value":"Teknologi Informasi","type":"text"},{"key":"supervisor_name","value":"Supervisor Industri","type":"text"},{"key":"supervisor_email","value":"supervisor@example.test","type":"text"},{"key":"supervisor_phone","value":"08123456789","type":"text"},{"key":"dpl_id","value":"{{dpl_id}}","type":"text"},{"key":"jenis_program","value":"magang","type":"text"},{"key":"posisi","value":"Software Developer Intern","type":"text"},{"key":"periode_mulai","value":"2026-08-01","type":"text"},{"key":"periode_selesai","value":"2026-12-31","type":"text"},{"key":"proposal_file","type":"file","src":"{{proposal_file}}"},{"key":"bukti_diterima_file","type":"file","src":"{{bukti_diterima_file}}"}]},"url":"{{base_url}}/api/magang"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Create magang succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));","if (pm.response.code >= 200 && pm.response.code < 300) { const d=pm.response.json(); const x=d.data || d; if (x.id != null) pm.environment.set('magang_id', String(x.id)); if (x.status) pm.environment.set('magang_status', String(x.status)); }"]}}]},
      {"name":"Show magang","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('magang_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/magang/{{magang_id}}"}},
      {"name":"List surat pengantar","request":{"method":"GET","url":"{{base_url}}/api/surat-pengantar"}},
      {"name":"Create surat pengantar","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('magang_id')) { pm.test('Skipped: magang prerequisite missing', () => pm.expect(true).to.be.true); pm.execution.skipRequest(); }"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Create surat pengantar returns 201', () => pm.expect(pm.response.code).to.eql(201));"]}}],"request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{surat_pengantar_file}}"}]},"url":"{{base_url}}/api/magang/{{magang_id}}/surat-pengantar"}},
      {"name":"Download surat pengantar","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('surat_pengantar_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/surat-pengantar/{{surat_pengantar_id}}/download"}},
      {"name":"Create usulan konversi","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["const magang = pm.environment.get('magang_id'); const mk = pm.environment.get('mata_kuliah_id'); const cpmk = pm.environment.get('cpmk_id'); if (!magang || !mk || !cpmk || pm.environment.get('magang_status') !== 'disetujui') { pm.test('Skipped: approved magang and course prerequisites missing', () => pm.expect(true).to.be.true); pm.execution.skipRequest(); }"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Create usulan returns 201', () => pm.expect(pm.response.code).to.eql(201)); if (pm.response.code === 201) { const d = pm.response.json().data || pm.response.json(); const detail = d.details && d.details[0]; if (d.status) pm.environment.set('usulan_status', String(d.status)); if (detail && detail.id != null) pm.environment.set('usulan_detail_id', String(detail.id)); }"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"magang_id\":\"{{magang_id}}\",\"details\":[{\"mata_kuliah_id\":\"{{mata_kuliah_id}}\",\"cpmk_id\":\"{{cpmk_id}}\",\"deskripsi_aktivitas_rencana\":\"Implementasi dan pengujian fitur API\"}]}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/usulan-konversi"}},
      {"name":"Show usulan","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('usulan_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/usulan-konversi/{{usulan_id}}"}},
      {"name":"Create klaim konversi","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('usulan_id') || pm.environment.get('usulan_status') !== 'disetujui' || !pm.environment.get('usulan_detail_id')) { pm.test('Skipped: approved usulan prerequisite missing', () => pm.expect(true).to.be.true); pm.execution.skipRequest(); }"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Create klaim returns 201', () => pm.expect(pm.response.code).to.eql(201));"]}}],"request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"formdata","formdata":[{"key":"usulan_konversi_id","value":"{{usulan_id}}","type":"text"},{"key":"logbook_file","type":"file","src":"{{logbook_file}}"},{"key":"laporan_file","type":"file","src":"{{laporan_file}}"},{"key":"sertifikat_file","type":"file","src":"{{sertifikat_file}}"},{"key":"details[0][usulan_konversi_detail_id]","value":"{{usulan_detail_id}}","type":"text"},{"key":"details[0][bukti_aktivitas_text]","value":"Pelaksanaan aktivitas magang dan hasil pekerjaan terdokumentasikan.","type":"text"},{"key":"details[0][bukti_file]","type":"file","src":"{{klaim_detail_file}}"}]},"url":"{{base_url}}/api/klaim-konversi"}},{"name":"Show klaim","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('klaim_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/klaim-konversi/{{klaim_id}}"}},{"name":"Klaim result","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('klaim_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/klaim-konversi/{{klaim_id}}/hasil"}},{"name":"Logout mahasiswa (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}
    ]},
    {"name":"DPL workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_dpl}}","type":"string"}]},"item":[{"name":"List usulan","request":{"method":"GET","url":"{{base_url}}/api/dpl/usulan-konversi"}},{"name":"Review usulan","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('usulan_id')) pm.execution.skipRequest();"]}}],"request":{"method":"POST","url":"{{base_url}}/api/dpl/usulan-konversi/{{usulan_id}}/review"}},{"name":"List klaim","request":{"method":"GET","url":"{{base_url}}/api/dpl/klaim-konversi"}},{"name":"Review klaim","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('klaim_id')) pm.execution.skipRequest();"]}}],"request":{"method":"POST","url":"{{base_url}}/api/dpl/klaim-konversi/{{klaim_id}}/review"}},{"name":"Logout DPL (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Admin workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_admin}}","type":"string"}]},"item":[{"name":"List magang","request":{"method":"GET","url":"{{base_url}}/api/admin/magang"}},{"name":"List mata kuliah","request":{"method":"GET","url":"{{base_url}}/api/admin/mata-kuliah"}},{"name":"List CPMK","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('mata_kuliah_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/admin/mata-kuliah/{{mata_kuliah_id}}/cpmk"}},{"name":"Export hasil konversi","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('mata_kuliah_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/admin/export/hasil-konversi?mata_kuliah_id={{mata_kuliah_id}}&from=2026-01-01&to=2026-12-31"}},{"name":"Logout admin (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Kaprodi workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_kaprodi}}","type":"string"}]},"item":[{"name":"Dashboard","request":{"method":"GET","url":"{{base_url}}/api/kaprodi/dashboard"}},{"name":"Temporary document URL","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('dokumen_id')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/dokumen/{{dokumen_id}}/temporary-url"}},{"name":"Logout kaprodi (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Public approval (manual only)","description":"Manual only. Runs only when approval_token is populated.","item":[{"name":"Show approval","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('approval_token')) pm.execution.skipRequest();"]}}],"request":{"method":"GET","url":"{{base_url}}/api/approval/{{approval_token}}"}},{"name":"Submit approval","event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('approval_token')) pm.execution.skipRequest();"]}}],"request":{"method":"POST","url":"{{base_url}}/api/approval/{{approval_token}}"}}]}
  ]
}
