{
  "info": {
    "name": "Hackathon2026 API",
    "description": "Ordered role-based workflow. Run login requests before each role folder; Google callback and approval requests require real provider/token values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"base_url","value":"http://127.0.0.1:8000"},
    {"key":"token_mahasiswa","value":""},{"key":"token_dpl","value":""},{"key":"token_admin","value":""},{"key":"token_kaprodi","value":""},
    {"key":"approval_token","value":""},{"key":"dokumen_id","value":""},{"key":"magang_id","value":""},{"key":"surat_pengantar_id","value":""},{"key":"usulan_id","value":""},{"key":"klaim_id","value":""},{"key":"mata_kuliah_id","value":""},{"key":"cpmk_id","value":""}
  ],
  "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Expected HTTP status', () => pm.expect([200,201,202,204,302,400,401,403,404,422]).to.include(pm.response.code));","if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.headers.get('Content-Type')?.includes('json')) { const d=pm.response.json(); const source=d.data || d; const id=source.id ?? d.id; const path=pm.request.url.toString(); const key=path.includes('/magang') && !path.includes('surat-pengantar') ? 'magang_id' : path.includes('/surat-pengantar') ? 'surat_pengantar_id' : path.includes('/usulan-konversi') ? 'usulan_id' : path.includes('/klaim-konversi') ? 'klaim_id' : path.includes('/mata-kuliah') && path.includes('/cpmk') ? 'cpmk_id' : path.includes('/mata-kuliah') ? 'mata_kuliah_id' : path.includes('/dokumen') ? 'dokumen_id' : null; if (key && id !== undefined && id !== null) pm.environment.set(key, String(id)); }"]}}],
  "item": [
    {"name":"00 Auth setup","item":[
      {"name":"Login mahasiswa","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"mahasiswa@students.amikom.ac.id\",\n  \"password\": \"Password123!\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.collectionVariables.set('token_mahasiswa', pm.response.json().access_token);"]}}]},
      {"name":"Login DPL","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"dpl@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.collectionVariables.set('token_dpl', pm.response.json().access_token);"]}}]},
      {"name":"Login admin","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin.prodi@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.collectionVariables.set('token_admin', pm.response.json().access_token);"]}}]},
      {"name":"Login kaprodi","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"kaprodi@amikom.ac.id\",\"password\":\"Password123!\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.collectionVariables.set('token_kaprodi', pm.response.json().access_token);"]}}]},
      {"name":"Google callback (manual only)","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/auth/google/callback","description":"SKIP in automated runs. Requires a real Google authorization code and provider redirect state."}}
    ]},
    {"name":"Mahasiswa workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_mahasiswa}}","type":"string"}]},"item":[
      {"name":"Me","request":{"method":"GET","url":"{{base_url}}/api/me"}},
      {"name":"Dashboard","request":{"method":"GET","url":"{{base_url}}/api/mahasiswa/dashboard"}},
      {"name":"List magang","request":{"method":"GET","url":"{{base_url}}/api/magang"}},
      {"name":"Create magang","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"mitra_industri_id\":1,\"supervisor_mitra_id\":1,\"dpl_id\":1,\"jenis_program\":\"magang\",\"posisi\":\"Software Developer Intern\",\"periode_mulai\":\"2026-08-01\",\"periode_selesai\":\"2026-12-31\"}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/magang"}},
      {"name":"Show magang","request":{"method":"GET","url":"{{base_url}}/api/magang/{{magang_id}}"}},
      {"name":"List surat pengantar","request":{"method":"GET","url":"{{base_url}}/api/surat-pengantar"}},
      {"name":"Create surat pengantar","request":{"method":"POST","url":"{{base_url}}/api/magang/{{magang_id}}/surat-pengantar"}},
      {"name":"Download surat pengantar","request":{"method":"GET","url":"{{base_url}}/api/surat-pengantar/{{surat_pengantar_id}}/download"}},
      {"name":"Create usulan konversi","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"magang_id\":\"{{magang_id}}\",\"details\":[]}","options":{"raw":{"language":"json"}}},"url":"{{base_url}}/api/usulan-konversi"}},
      {"name":"Show usulan","request":{"method":"GET","url":"{{base_url}}/api/usulan-konversi/{{usulan_id}}"}},
      {"name":"Create klaim konversi","request":{"method":"POST","url":"{{base_url}}/api/klaim-konversi"}},
      {"name":"Show klaim","request":{"method":"GET","url":"{{base_url}}/api/klaim-konversi/{{klaim_id}}"}},
      {"name":"Klaim result","request":{"method":"GET","url":"{{base_url}}/api/klaim-konversi/{{klaim_id}}/hasil"}},
      {"name":"Logout mahasiswa (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}
    ]},
    {"name":"DPL workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_dpl}}","type":"string"}]},"item":[{"name":"List usulan","request":{"method":"GET","url":"{{base_url}}/api/dpl/usulan-konversi"}},{"name":"Review usulan","request":{"method":"POST","url":"{{base_url}}/api/dpl/usulan-konversi/{{usulan_id}}/review"}},{"name":"List klaim","request":{"method":"GET","url":"{{base_url}}/api/dpl/klaim-konversi"}},{"name":"Review klaim","request":{"method":"POST","url":"{{base_url}}/api/dpl/klaim-konversi/{{klaim_id}}/review"}},{"name":"Logout DPL (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Admin workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_admin}}","type":"string"}]},"item":[{"name":"List magang","request":{"method":"GET","url":"{{base_url}}/api/admin/magang"}},{"name":"List mata kuliah","request":{"method":"GET","url":"{{base_url}}/api/admin/mata-kuliah"}},{"name":"List CPMK","request":{"method":"GET","url":"{{base_url}}/api/admin/mata-kuliah/{{mata_kuliah_id}}/cpmk"}},{"name":"Export hasil konversi","request":{"method":"GET","url":"{{base_url}}/api/admin/export/hasil-konversi?mata_kuliah_id={{mata_kuliah_id}}&from=2026-01-01&to=2026-12-31"}},{"name":"Logout admin (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Kaprodi workflow","auth":{"type":"bearer","bearer":[{"key":"token","value":"{{token_kaprodi}}","type":"string"}]},"item":[{"name":"Dashboard","request":{"method":"GET","url":"{{base_url}}/api/kaprodi/dashboard"}},{"name":"Temporary document URL","request":{"method":"GET","url":"{{base_url}}/api/dokumen/{{dokumen_id}}/temporary-url"}},{"name":"Logout kaprodi (last)","request":{"method":"POST","url":"{{base_url}}/api/logout"}}]},
    {"name":"Public approval (manual token required)","description":"SKIP unless approval_token contains a real token returned by the API. No Authorization header is used by these public routes.","item":[{"name":"Show approval","request":{"method":"GET","url":"{{base_url}}/api/approval/{{approval_token}}"}},{"name":"Submit approval","request":{"method":"POST","url":"{{base_url}}/api/approval/{{approval_token}}"}}]}
  ]
}
